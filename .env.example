# Copy to .env and adjust. Used by docker-compose and Spring (application.properties defaults match these).
DB_HOST=localhost
# 5433 avoids clashing with a locally installed Postgres on 5432
DB_PORT=5433
DB_NAME=flyaway
DB_USER=admin
DB_PASSWORD=admin123
# Mission 3 (JWT) — to be used by the auth module
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
